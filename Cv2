    <!-- Bootstrap 5 CSS & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        :root {
            --primary: #1f4e8c;
            --primary-dark: #14345e;
            --accent: #f4b942;
            --soft-bg: #f3f6fb;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "Segoe UI", system-ui, -apple-system, Roboto, sans-serif;
            background-color: var(--soft-bg);
            color: #2b3340;
            padding-top: 64px; /* ruang untuk navbar fixed */
        }

        section {
            scroll-margin-top: 80px;
        }

        /* ---------- Navbar ---------- */
        .navbar {
            background-color: var(--primary-dark);
        }

        .navbar .nav-link {
            color: rgba(255, 255, 255, .8);
            font-weight: 500;
            transition: color .2s;
        }

        .navbar .nav-link:hover,
        .navbar .nav-link:focus {
            color: var(--accent);
        }

        /* ---------- Header / Hero ---------- */
        .hero {
            background: linear-gradient(135deg, var(--primary-dark), var(--primary));
            color: #fff;
            padding: 4rem 0 5rem;
            text-align: center;
        }

        .hero .avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: var(--accent);
            color: var(--primary-dark);
            font-size: 2.8rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.25rem;
            border: 5px solid rgba(255, 255, 255, .35);
            box-shadow: 0 8px 24px rgba(0, 0, 0, .25);
        }

        .hero .label {
            letter-spacing: .25em;
            text-transform: uppercase;
            font-size: .8rem;
            opacity: .75;
        }

        .hero h2 {
            font-weight: 700;
        }

        /* ---------- Section ---------- */
        .section-title {
            font-weight: 700;
            color: var(--primary-dark);
            margin-bottom: 1.5rem;
            padding-bottom: .5rem;
            position: relative;
        }

        .section-title::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            width: 60px;
            height: 4px;
            border-radius: 2px;
            background: var(--accent);
        }

        .cv-card {
            border: 0;
            border-radius: 1rem;
            box-shadow: 0 4px 18px rgba(31, 78, 140, .08);
            transition: transform .2s, box-shadow .2s;
        }

        .cv-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 26px rgba(31, 78, 140, .15);
        }

        .cv-card h3 {
            color: var(--primary);
        }

        /* ---------- Tabel ---------- */
        .table thead th {
            background-color: var(--primary);
            color: #fff;
            border-color: var(--primary);
            white-space: nowrap;
        }

        .table-wrap {
            border-radius: 1rem;
            overflow: hidden;
            box-shadow: 0 4px 18px rgba(31, 78, 140, .08);
            background: #fff;
        }

        .table-wrap .table {
            margin-bottom: 0;
        }

        /* ---------- Keahlian & Hobi ---------- */
        .skill-list li,
        .hobby-list li {
            padding: .75rem 1rem;
            margin-bottom: .6rem;
            background: #fff;
            border-radius: .75rem;
            border-left: 5px solid var(--accent);
            box-shadow: 0 2px 10px rgba(31, 78, 140, .06);
            list-style: none;
        }

        .skill-list,
        .hobby-list {
            padding-left: 0;
            margin-bottom: 0;
        }

        .hobby-list {
            counter-reset: hobi;
        }

        .hobby-list li {
            counter-increment: hobi;
            display: flex;
            align-items: center;
        }

        .hobby-list li::before {
            content: counter(hobi);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 30px;
            margin-right: .85rem;
            border-radius: 50%;
            background: var(--primary);
            color: #fff;
            font-weight: 600;
            flex-shrink: 0;
        }

        /* ---------- Kontak ---------- */
        address {
            margin: 0;
        }

        .btn-contact {
            background-color: var(--primary);
            color: #fff;
            border-radius: 2rem;
            padding: .6rem 1.5rem;
            word-break: break-all;
        }

        .btn-contact:hover {
            background-color: var(--primary-dark);
            color: var(--accent);
        }

        /* ---------- Footer ---------- */
        footer {
            background-color: var(--primary-dark);
            color: rgba(255, 255, 255, .8);
        }

        /* ---------- Mobile ---------- */
        @media (max-width: 575.98px) {
            .hero {
                padding: 3rem 0 3.5rem;
            }

            .hero .avatar {
                width: 96px;
                height: 96px;
                font-size: 2.2rem;
            }

            .hero h1 {
                font-size: 1.6rem;
            }

            .hero h2 {
                font-size: 1.3rem;
            }
        }
    </style>
</head>

